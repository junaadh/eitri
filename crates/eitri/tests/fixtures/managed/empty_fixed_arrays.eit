//! host: test
import test from "test"
struct Item { name: string }
struct Holder { values: [0]Item, marker: i64 }
fn same(value: [0]string) -> [0]string { return value }
let empty: [0]string = []
let copy = same(empty)
test.check(empty == copy)
let holder = Holder { values: [], marker: 9 }
test.check(holder.marker == 9 && holder.values == holder.values)
class Store { values: [0]Item, marker: i64 }
enum Box { Items(values: [0]Item) }
let store = Store { values: [], marker: 10 }
test.check(store.marker == 10 && store.values == holder.values)
test.check(match Box.Items(holder.values) { .Items(value) => value == holder.values })
