//! host: test
import test from "test"
enum List { Empty, @indirect Cons(head: string, tail: List) }
fn count(list: List) -> i64 { return match list { .Empty => 0, .Cons(_, tail) => 1 + count(tail) } }
let list = List.Cons("first", List.Cons("second", List.Empty))
test.check(count(list) == 2)
test.check(match list { .Empty => false, .Cons(head, _) => head == "first" })
let same = List.Cons("first", List.Cons("second", List.Empty))
let different = List.Cons("first", List.Cons("other", List.Empty))
test.check(list == same && list != different)
test.check(List.Empty == List.Empty && List.Empty != list)
class Marker { value: i64 }
enum Tree { Leaf, @indirect Data(marker: Marker, number: f64) }
let marker = Marker { value: 1 }
let same_marker = Tree.Data(marker, 0.0)
let same_contents = Tree.Data(marker, -0.0)
let other_marker = Tree.Data(Marker { value: 1 }, 0.0)
let nan = Tree.Data(marker, 0.0 / 0.0)
test.check(same_marker == same_contents && same_marker != other_marker && nan != nan)
