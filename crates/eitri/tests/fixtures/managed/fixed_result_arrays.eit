//! host: test
import test from "test"
enum Problem { Bad(text: string) }
fn choose(ok: bool) -> Problem!string {
    if ok { return "yes" }
    return .Err(Problem.Bad("no"))
}
var values: [2]<Problem!string> = [choose(true), choose(false)]
let copy = values
test.check(match values[0] { .Ok(text) => text == "yes", .Err => false })
test.check(match values[1] { .Ok => false, .Err(.Bad(text)) => text == "no" })
values[0] = choose(false)
test.check(match values[0] { .Ok => false, .Err(.Bad(text)) => text == "no" })
test.check(match copy[0] { .Ok(text) => text == "yes", .Err => false })
struct Holder { values: [2]<Problem!string>, marker: i64 }
class Store { values: [2]<Problem!string> }
enum Box { Values(values: [2]<Problem!string>) }
let holder = Holder { values: copy, marker: 9 }
let store = Store { values: values }
test.check(holder.marker == 9 && match holder.values[0] { .Ok(text) => text == "yes", .Err => false })
test.check(match store.values[1] { .Ok => false, .Err(.Bad(text)) => text == "no" })
test.check(match Box.Values(copy) { .Values(items) => match items[0] { .Ok(text) => text == "yes", .Err => false } })
test.check(copy == holder.values)
let empty: [0]<Problem!string> = []
test.check(empty == empty)
