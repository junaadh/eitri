//! host: test
import test from "test"
struct Box { text: ?string }
enum Choice { Empty, Value(item: ?string) }
fn identity(value: ?string) -> ?string { return value }
let present = Box { text: "alive" }
let absent = Box { text: null }
let wrapped = Choice.Value(item: identity(present.text))
test.check((present.text ?? "missing") == "alive")
test.check((absent.text ?? "missing") == "missing")
test.check(match wrapped { .Empty => false, .Value(item) => item == "alive", .Value(_) => false })
test.check(present == Box { text: "alive" })
let collapsed: ???string = "alive"
test.check(present.text != null && absent.text == null)
test.check(null == absent.text && "alive" == collapsed)
fn fallback() -> string { test.emit(9); return "fallback" }
test.check((present.text ?? fallback()) == "alive")
test.check((absent.text ?? fallback()) == "fallback")
test.check((absent.text ?? present.text ?? "wrong") == "alive")
let from_null = null ?? "direct"
let picked: ?string = absent.text ?? present.text
let neither: ?string = null ?? null
test.check(from_null == "direct" && picked == "alive" && neither == null)
test.check(null != "x" && "x" != null)
