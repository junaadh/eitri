//! host: test
import test from "test"
struct Config { values: [3]i64, name: string }
fn identity(values: [3]i64) -> [3]i64 { return values }
let original: [3]i64 = [1, 2, 3]
let copy = identity(original)
let config = Config { values: copy, name: "array" }
test.check(original == copy && config.values == [1, 2, 3])
test.check(config.name == "array" && original != [1, 3, 2])
let index = test.id(1)
test.check(original[0] == 1 && config.values[index] == 2 && original[2] == 3)
var changed: [3]i64 = original
changed[index] = 10
changed[2] += 5
test.check(changed == [1, 10, 8] && original == [1, 2, 3])
var mutable = Config { values: [4, 5, 6], name: "copy" }
mutable.values[1] += 3
test.check(mutable.values[1] == 8 && config.values[1] == 2)
class ArrayBox { values: [3]i64, nested: Config }
let box = ArrayBox { values: [1, 2, 3], nested: Config { values: [7, 8, 9], name: "nested" } }
box.values[1] = 11
box.nested.values[2] += 5
test.check(box.values[1] == 11 && box.nested.values[2] == 14)
