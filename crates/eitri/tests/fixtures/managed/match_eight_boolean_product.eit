//! host: test
import test from "test"
enum Data { Bits(b0: bool, b1: bool, b2: bool, b3: bool, b4: bool, b5: bool, b6: bool, b7: bool) }
let value = match Data.Bits(true, true, true, true, true, true, true, true) {
    .Bits(false, _, _, _, _, _, _, _) => 0,
    .Bits(true, false, _, _, _, _, _, _) => 1,
    .Bits(true, true, false, _, _, _, _, _) => 2,
    .Bits(true, true, true, false, _, _, _, _) => 3,
    .Bits(true, true, true, true, false, _, _, _) => 4,
    .Bits(true, true, true, true, true, false, _, _) => 5,
    .Bits(true, true, true, true, true, true, false, _) => 6,
    .Bits(true, true, true, true, true, true, true, false) => 7,
    .Bits(true, true, true, true, true, true, true, true) => 8,
}
test.check(value == 8)
