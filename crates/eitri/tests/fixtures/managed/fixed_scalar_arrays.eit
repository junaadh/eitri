//! host: test
import test from "test"
let signed: [2]i8 = [-128, 127]
let octets: [2]u8 = [0, 255]
let wide: [1]u64 = [18446744073709551615]
let single: [2]f32 = [1.5, -0.0]
let double: [2]f64 = [2.5, 0.0]
let flags: [2]bool = [true, false]
let letters: [2]char = ['a', 'z']
test.check(signed[0] == -128 && octets[1] == 255 && wide[0] == 18446744073709551615)
test.check(single[0] == 1.5 && double[0] == 2.5 && flags[0] && letters[1] == 'z')
test.check(single == [1.5, 0.0])
var writable: [2]u8 = [1, 2]
writable[1] += 3
test.check(writable[1] == 5)
