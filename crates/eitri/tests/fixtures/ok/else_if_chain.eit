//! host: test
import test from "test"
fn grade(n: i64) -> i64 {
    return if n < 10 { 1 } else if n < 20 { 2 } else if n < 30 {
        let base = 2
        base + 1
    } else if n < 40 { 4 } else { 5 }
}
fn bucket(n: i64) -> void {
    if n == 0 {
        test.emit(100)
    } else if n == 1 {
        test.emit(101)
    } else if n == 2 {
        test.emit(102)
    }
}
var i = 0
while i < 5 {
    test.emit(grade(i * 10 + 5))
    bucket(i)
    i += 1
}
