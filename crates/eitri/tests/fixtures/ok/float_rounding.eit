//! host: test
import test from "test"
let tie_even: f32 = 1.000000059604644775390625
let tie_odd: f32 = 1.000000178813934326171875
let above_tie: f32 = 1.000000059604644775390626
test.check(tie_even == 1.0)
test.check(tie_odd == 1.0000002384185791015625)
test.check(above_tie == 1.00000011920928955078125)
let even64: f64 = 1.00000000000000011102230246251565404236316680908203125
test.check(even64 == 1.0)
let underflow: f64 = -1e-999
let subnormal: f64 = 5e-324
test.check(1.0 / underflow == -1.0 / 0.0)
test.check(subnormal > 0.0)
test.check(f64(f32(-1e100)) == -1.0 / 0.0)
test.check(f32(16777219) == 16777220)
test.check(f64(9007199254740993) == 9007199254740992)
test.check(f64(9007199254740995) == 9007199254740996)
