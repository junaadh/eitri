//! host: test
import test from "test"
fn sign(n: i64) -> i64 {
    return if n < 0 { -1 } else if n == 0 { 0 } else { 1 }
}
test.emit(sign(-9))
test.emit(sign(0))
test.emit(sign(9))
let big = if sign(5) == 1 {
    let doubled = 5 * 2
    doubled + 1
} else {
    0
}
test.emit(big)
if big > 10 {
    test.emit(1)
}
if big > 100 {
    test.emit(2)
} else {
    test.emit(3)
}
