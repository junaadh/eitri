; arithmetic.eit

declare void @bench.emit(i64)

define void @<module>() frame(2) {
bb0:
    %r1 = ldi i64 1000
    %r0 = call.script i64 @mix(i64 %r1)
    call.host void @bench.emit(i64 %r0)
    ret
}

define i64 @mix(i64 %r1) frame(6) {
bb0:
    %r2 = ldi i64 0
    %r3 = ldi i64 0
bb1:
    cb.le %r1, %r3, label %bb3
bb2:
    %r5 = muli.chk.s %r3, 3
    %r4 = add.chk.s %r2, %r5
    %r5 = ldi i64 7
    %r5 = div.s %r3, %r5
    %r4 = sub.chk.s %r4, %r5
    %r5 = ldi i64 5
    %r5 = rem.s %r3, %r5
    %r2 = add.chk.s %r4, %r5
    %r5 = ldi i64 31
    %r4 = mul.wrap %r2, %r5
    %r2 = add.wrap %r4, %r3
    %r3 = addi.chk.s %r3, 1
    j label %bb1
bb3:
    %r0 = mov %r2
    ret
}
